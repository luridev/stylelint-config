{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@protoapps/stylelint-config": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/*.ts", "scripts/**/*.ts", "*.config.ts"]
}
